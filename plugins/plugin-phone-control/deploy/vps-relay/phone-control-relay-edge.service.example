[Unit]
Description=Phone Control isolated HTTPS relay edge
After=network-online.target phone-control-relay-frps.service
Wants=network-online.target

[Service]
Type=forking
PIDFile=/opt/phone-control-relay/nginx/logs/nginx.pid
ExecStartPre=/usr/sbin/nginx -p /opt/phone-control-relay/nginx/ -c conf/nginx.conf -t
ExecStart=/usr/sbin/nginx -p /opt/phone-control-relay/nginx/ -c conf/nginx.conf
ExecReload=/usr/sbin/nginx -p /opt/phone-control-relay/nginx/ -c conf/nginx.conf -s reload
ExecStop=/usr/sbin/nginx -p /opt/phone-control-relay/nginx/ -c conf/nginx.conf -s quit
Restart=on-failure
RestartSec=2
PrivateTmp=true

[Install]
WantedBy=multi-user.target
