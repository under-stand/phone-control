{
  "description": "Report passive Codex lifecycle events to the local Phone Control sidecar.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "if [ -f \"${PLUGIN_DATA}/hook-runtime/scripts/hook.mjs\" ]; then node \"${PLUGIN_DATA}/hook-runtime/scripts/hook.mjs\"; else node \"${PLUGIN_ROOT}/scripts/hook.mjs\"; fi",
            "commandWindows": "$runtime = Join-Path $env:PLUGIN_DATA 'hook-runtime\\scripts\\hook.mjs'; if (Test-Path -LiteralPath $runtime) { & node $runtime } else { & node (Join-Path $env:PLUGIN_ROOT 'scripts\\hook.mjs') }",
            "timeout": 1
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "if [ -f \"${PLUGIN_DATA}/hook-runtime/scripts/hook.mjs\" ]; then node \"${PLUGIN_DATA}/hook-runtime/scripts/hook.mjs\"; else node \"${PLUGIN_ROOT}/scripts/hook.mjs\"; fi",
            "commandWindows": "$runtime = Join-Path $env:PLUGIN_DATA 'hook-runtime\\scripts\\hook.mjs'; if (Test-Path -LiteralPath $runtime) { & node $runtime } else { & node (Join-Path $env:PLUGIN_ROOT 'scripts\\hook.mjs') }",
            "timeout": 1
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "if [ -f \"${PLUGIN_DATA}/hook-runtime/scripts/hook.mjs\" ]; then node \"${PLUGIN_DATA}/hook-runtime/scripts/hook.mjs\"; else node \"${PLUGIN_ROOT}/scripts/hook.mjs\"; fi",
            "commandWindows": "$runtime = Join-Path $env:PLUGIN_DATA 'hook-runtime\\scripts\\hook.mjs'; if (Test-Path -LiteralPath $runtime) { & node $runtime } else { & node (Join-Path $env:PLUGIN_ROOT 'scripts\\hook.mjs') }",
            "timeout": 1
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "if [ -f \"${PLUGIN_DATA}/hook-runtime/scripts/hook.mjs\" ]; then node \"${PLUGIN_DATA}/hook-runtime/scripts/hook.mjs\"; else node \"${PLUGIN_ROOT}/scripts/hook.mjs\"; fi",
            "commandWindows": "$runtime = Join-Path $env:PLUGIN_DATA 'hook-runtime\\scripts\\hook.mjs'; if (Test-Path -LiteralPath $runtime) { & node $runtime } else { & node (Join-Path $env:PLUGIN_ROOT 'scripts\\hook.mjs') }",
            "timeout": 1
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "if [ -f \"${PLUGIN_DATA}/hook-runtime/scripts/hook.mjs\" ]; then node \"${PLUGIN_DATA}/hook-runtime/scripts/hook.mjs\"; else node \"${PLUGIN_ROOT}/scripts/hook.mjs\"; fi",
            "commandWindows": "$runtime = Join-Path $env:PLUGIN_DATA 'hook-runtime\\scripts\\hook.mjs'; if (Test-Path -LiteralPath $runtime) { & node $runtime } else { & node (Join-Path $env:PLUGIN_ROOT 'scripts\\hook.mjs') }",
            "timeout": 1
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "if [ -f \"${PLUGIN_DATA}/hook-runtime/scripts/permission-hook.mjs\" ]; then node \"${PLUGIN_DATA}/hook-runtime/scripts/permission-hook.mjs\"; else node \"${PLUGIN_ROOT}/scripts/permission-hook.mjs\"; fi",
            "commandWindows": "$runtime = Join-Path $env:PLUGIN_DATA 'hook-runtime\\scripts\\permission-hook.mjs'; if (Test-Path -LiteralPath $runtime) { & node $runtime } else { & node (Join-Path $env:PLUGIN_ROOT 'scripts\\permission-hook.mjs') }",
            "timeout": 55
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "if [ -f \"${PLUGIN_DATA}/hook-runtime/scripts/hook.mjs\" ]; then node \"${PLUGIN_DATA}/hook-runtime/scripts/hook.mjs\"; else node \"${PLUGIN_ROOT}/scripts/hook.mjs\"; fi",
            "commandWindows": "$runtime = Join-Path $env:PLUGIN_DATA 'hook-runtime\\scripts\\hook.mjs'; if (Test-Path -LiteralPath $runtime) { & node $runtime } else { & node (Join-Path $env:PLUGIN_ROOT 'scripts\\hook.mjs') }",
            "timeout": 1
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "if [ -f \"${PLUGIN_DATA}/hook-runtime/scripts/hook.mjs\" ]; then node \"${PLUGIN_DATA}/hook-runtime/scripts/hook.mjs\"; else node \"${PLUGIN_ROOT}/scripts/hook.mjs\"; fi",
            "commandWindows": "$runtime = Join-Path $env:PLUGIN_DATA 'hook-runtime\\scripts\\hook.mjs'; if (Test-Path -LiteralPath $runtime) { & node $runtime } else { & node (Join-Path $env:PLUGIN_ROOT 'scripts\\hook.mjs') }",
            "timeout": 1
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "if [ -f \"${PLUGIN_DATA}/hook-runtime/scripts/hook.mjs\" ]; then node \"${PLUGIN_DATA}/hook-runtime/scripts/hook.mjs\"; else node \"${PLUGIN_ROOT}/scripts/hook.mjs\"; fi",
            "commandWindows": "$runtime = Join-Path $env:PLUGIN_DATA 'hook-runtime\\scripts\\hook.mjs'; if (Test-Path -LiteralPath $runtime) { & node $runtime } else { & node (Join-Path $env:PLUGIN_ROOT 'scripts\\hook.mjs') }",
            "timeout": 1
          }
        ]
      }
    ]
  }
}
